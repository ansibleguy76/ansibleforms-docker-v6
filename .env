# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level for file logging (error, warn, notice, info, debug)
# Default: notice
LOG_LEVEL=info

# Log level for console output (error, warn, notice, info, debug)
# Default: debug
LOG_CONSOLE_LEVEL=info

# Log timezone - use IANA timezone string (e.g., UTC, Europe/Amsterdam, America/New_York)
# Default: UTC
# LOG_TZ=UTC

# Path for log files (ansibleforms.log and ansibleforms.errors.log)
# Daily rotating logs with 30 days retention
# Default: %PERSISTENT_FOLDER%/logs
# LOG_PATH=%PERSISTENT_FOLDER%/logs

# Syslog configuration (optional)
# LOG_SYSLOG_HOST=
# LOG_SYSLOG_PORT=514
# LOG_SYSLOG_LEVEL=debug
# LOG_SYSLOG_PROTOCOL=udp4
# LOG_SYSLOG_TYPE=BSD
# LOG_SYSLOG_APPNAME=Ansible Forms

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL/MariaDB root user credentials
MYSQLDB_USER=root
MYSQLDB_PASSWORD=AnsibleForms!123

# MySQL port on the host machine
MYSQLDB_LOCAL_PORT=3306

# MySQL port inside Docker container (must be 3306)
MYSQLDB_DOCKER_PORT=3306

# Database connection settings for Ansible Forms
# DB_HOST=mysql
# DB_USER=root
# DB_PASSWORD=AnsibleForms!123

# Database encryption secret - CRITICAL: Do not change once set or passwords will be lost!
# Must be a strong 32-character string, but it will be truncated/padded as needed
# ENCRYPTION_SECRET=AnsibleForms!123

# Enable database query logging (0=disabled, 1=enabled)
# Default: 0 - Only enable for debugging
# ENABLE_DB_QUERY_LOGGING=0

# MySQL/MariaDB command customization (for different flavors)
# Default: mariadb-dump --ssl-verify-server-cert=OFF
# MYSQLDUMP_COMMAND=mariadb-dump --ssl-verify-server-cert=OFF

# Default: mariadb --ssl-verify-server-cert=OFF
# MYSQL_COMMAND=mariadb --ssl-verify-server-cert=OFF

# =============================================================================
# WEB APPLICATION CONFIGURATION
# =============================================================================

# Node.js environment (development, production)
# Default: production
NODE_ENV=production

# HTTP port for the web application
# Default: 8000
# PORT=8000

# Web application port on the host machine
WEBAPP_LOCAL_PORT=443

# Web application port inside Docker container
WEBAPP_DOCKER_PORT=443

# Enable HTTPS (0=disabled, 1=enabled)
# Highly recommended for production
HTTPS=1

# HTTPS certificate paths (BASE64/PEM format)
# Default: %PERSISTENT_FOLDER%/certificates/key.pem
# HTTPS_KEY=%PERSISTENT_FOLDER%/certificates/key.pem

# Default: %PERSISTENT_FOLDER%/certificates/cert.pem
# HTTPS_CERT=%PERSISTENT_FOLDER%/certificates/cert.pem

# =============================================================================
# AUTHENTICATION & AUTHORIZATION
# =============================================================================

# Default admin user credentials (created on first start if not present)
# Added to the admins group automatically
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AnsibleForms!123

# JWT access token secret - strongly recommended to set a custom value
# ACCESS_TOKEN_SECRET=AnsibleForms!123

# JWT access token expiration time
# Default: 30m
# ACCESS_TOKEN_EXPIRATION=30m

# JWT refresh token expiration time
# Default: 24h
# ACCESS_TOKEN_REFRESH_EXPIRATION=24h

# JWT token issuer
# Default: ansibleforms
# ACCESS_TOKEN_ISSUER=ansibleforms

# Enable bypass admin authentication (DANGEROUS - use only when locked out)
# 0=disabled (default), 1=enabled - allows ANYONE to login as admin
# ENABLE_BYPASS=0

# =============================================================================
# ANSIBLE & PLAYBOOK CONFIGURATION
# =============================================================================

# Path to Ansible playbooks directory
# Default: %PERSISTENT_FOLDER%/playbooks
# ANSIBLE_PATH=%PERSISTENT_FOLDER%/playbooks

# Regex to filter job output (e.g., hide tasks tagged with [low])
# Default: \[low\]
# REGEX_FILTER_JOB_OUTPUT=\[low\]

# Regex to mask sensitive extravars (case insensitive)
# Values matching this regex will be masked with ********
# Default: password|secret|token
# MASK_EXTRAVARS_REGEX=password|secret|token

# Maximum buffer size for process execution (increase for large output)
# Default: 1048576 (1024 * 1024)
# PROCESS_MAX_BUFFER=1048576

# =============================================================================
# FORMS CONFIGURATION
# =============================================================================

# Path to the main forms.yaml configuration file
# Default: %PERSISTENT_FOLDER%/forms.yaml
# FORMS_PATH=%PERSISTENT_FOLDER%/forms.yaml

# Enable forms.yaml storage in database instead of file
# 0=file-based (default), 1=database
# ENABLE_FORMS_YAML_IN_DATABASE=0

# Enable internal YAML designer (0=disabled, 1=enabled)
# Default: 1
# SHOW_DESIGNER=1

# Lock file path (ensures only one user can use the designer)
# Default: %PERSISTENT_FOLDER%/ansibleForms.lock
# LOCK_PATH=%PERSISTENT_FOLDER%/ansibleForms.lock

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Path for database and forms backups
# Default: %PERSISTENT_FOLDER%/backups
# BACKUP_PATH=%PERSISTENT_FOLDER%/backups

# Path for form-specific backups
# Default: %PERSISTENT_FOLDER%/form_backups
# FORMS_BACKUP_PATH=%PERSISTENT_FOLDER%/form_backups

# Number of days to keep old backups
# Default: 60
# OLD_BACKUP_DAYS=60

# =============================================================================
# GIT REPOSITORY CONFIGURATION
# =============================================================================

# Root path for local git repositories
# Default: %PERSISTENT_FOLDER%/repositories
# REPO_PATH=%PERSISTENT_FOLDER%/repositories

# Git clone command (branch and repository auto-added)
# Default: git clone
# GIT_CLONE_COMMAND=git clone

# Git pull command (branch and repository auto-added)
# Default: git pull
# GIT_PULL_COMMAND=git pull

# User home directory (for SSH keys and git connections)
# Default: OS home directory
HOME_DIR=/root

# =============================================================================
# YTT (YAML TEMPLATING TOOL) CONFIGURATION
# =============================================================================

# Enable ytt interpreter (0=disabled, 1=enabled)
# See: https://github.com/carvel-dev/ytt
# Default: 0
# USE_YTT=0

# Allowed symlink destination paths (multiple paths separated by path.delimiter)
# YTT_ALLOW_SYMLINK_DESTINATIONS=

# DANGEROUS: Allow symlinks everywhere (0=disabled, 1=enabled)
# Default: 0 - enabling comes with security risks
# YTT_DANGEROUS_ALLOW_ALL_SYMLINK_DESTINATIONS=0

# Environment variable prefix for ytt data values
# Example: MY_PREFIX_my_var=value results in ytt data value my_var=value
# YTT_VARS_PREFIX=

# Ytt library data (dynamic variables)
# Example: YTT_LIB_DATA_MYLIB=values.yml
# YTT_LIB_DATA_{name}=

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Path for file uploads (for file upload field type)
# Default: %PERSISTENT_FOLDER%/uploads
# UPLOAD_PATH=%PERSISTENT_FOLDER%/uploads

# =============================================================================
# AWX INTEGRATION
# =============================================================================

# AWX API prefix
# Default: /api/v2
# AWX_API_PREFIX=/api/v2

# =============================================================================
# AZURE AD INTEGRATION
# =============================================================================

# Azure Graph API base URI (without trailing slash)
# Default: https://graph.microsoft.com
# AZURE_GRAPH_URI=https://graph.microsoft.com

# =============================================================================
# NAVIGATION CUSTOMIZATION
# =============================================================================

# Label for the home navigation link
# Default: Forms
# NAV_HOME_LABEL=Forms

# Icon for the home navigation link (free FontAwesome icon name)
# Default: home
# NAV_HOME_ICON=home

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Enable schema creation on first start (0=disabled, 1=enabled)
# Default: 1 - disable to prevent accidental schema re-creation
# ALLOW_SCHEMA_CREATION=1

# Enable database query logging (0=disabled, 1=enabled)
# Default: 0 - massive logging, use only for debugging
# ENABLE_DB_QUERY_LOGGING=0



